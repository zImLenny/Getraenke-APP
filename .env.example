# Kopiere diese Datei nach .env und passe die Werte an.

# Start-Admin. Wird nur angelegt, solange noch kein Admin existiert.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern

# Optional: Gäste brauchen diesen Code zum Registrieren. Leer = jeder darf sich registrieren.
REGISTRATION_CODE=party2026

# Nur für docker-compose mit Caddy: deine Domain, z. B. getraenke.example.de
DOMAIN=getraenke.example.de
